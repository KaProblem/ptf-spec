{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KaProblem/ptf-spec/schemas/bundle-index.schema.json",
  "title": "PTF Bundle index.md frontmatter",
  "type": "object",
  "required": [
    "type",
    "ptf_version",
    "id",
    "title",
    "lang"
  ],
  "properties": {
    "type": {
      "const": "Bundle"
    },
    "okf_version": {
      "type": "string"
    },
    "ptf_version": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "lang": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z.-]+)?$"
    },
    "levels": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "rank"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          },
          "rank": {
            "type": "number"
          },
          "description": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": true
}
