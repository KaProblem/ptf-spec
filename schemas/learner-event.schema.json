{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KaProblem/ptf-spec/schemas/learner-event.schema.json",
  "title": "PTF Learner Event (one line of events.jsonl)",
  "type": "object",
  "required": [
    "id",
    "at",
    "verb",
    "object"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "at": {
      "type": "string",
      "format": "date-time"
    },
    "verb": {
      "enum": [
        "answered",
        "assessed",
        "completed",
        "skipped",
        "started",
        "left",
        "consented",
        "withdrew",
        "profile_updated",
        "experienced",
        "attempted",
        "station_completed",
        "level_changed",
        "understood",
        "rephrase",
        "deeper",
        "stuck",
        "asked",
        "reported_broken"
      ]
    },
    "object": {
      "type": "string",
      "pattern": "^ptf:(el|path|sim|learner)",
      "description": "Global PTF ID; `ptf:learner` for profile_updated."
    },
    "level": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "result": {
      "type": "object",
      "properties": {
        "correct": {
          "type": "boolean"
        },
        "score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "response": {
          "type": "string"
        },
        "misconception": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "duration_s": {
          "type": "number",
          "minimum": 0
        },
        "consent": {
          "type": "array",
          "description": "Legacy (0.2): sharing agreed to with `started`. Hosts read it as a consented event.",
          "items": {
            "type": "object",
            "required": [
              "with",
              "areas"
            ],
            "properties": {
              "with": {
                "type": "string"
              },
              "areas": {
                "type": "array",
                "items": {
                  "enum": [
                    "progress",
                    "mastery",
                    "answers"
                  ]
                }
              },
              "required": {
                "type": "boolean"
              }
            }
          }
        },
        "objectives": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "description": "answered: objectives the question checks; completed, assessed: objectives shown (LEARNER-RECORD.md \u00a75)."
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "completed, assessed: IDs of the answered events that show each objective."
        },
        "fields": {
          "type": "object",
          "description": "profile_updated: the profile fields set, merged in event order (LEARNER-RECORD.md \u00a73)."
        },
        "with": {
          "type": "string",
          "minLength": 1,
          "description": "consented, withdrew: the concrete recipient, a catalog ID or a URL (LEARNER-RECORD.md \u00a77)."
        },
        "areas": {
          "type": "array",
          "items": {
            "enum": [
              "progress",
              "mastery",
              "answers"
            ]
          }
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "context": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^ptf:path/"
        },
        "catalog": {
          "type": "string",
          "description": "ID of the catalog the object came from (CATALOG.md \u00a71)."
        },
        "version": {
          "type": "string",
          "description": "Version of the element, path or simulator the event refers to."
        },
        "reason": {
          "type": "string",
          "description": "assessed: placement or recap; completed: placement when shown before teaching."
        },
        "host": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "note": {
      "type": "string",
      "maxLength": 1000,
      "description": "The tutor's note for the next session (LEARNER-RECORD.md \u00a72)."
    },
    "keep": {
      "type": "string",
      "maxLength": 2000,
      "description": "The learner's own explanation that made it click (LEARNER-RECORD.md \u00a72)."
    }
  },
  "additionalProperties": true
}
