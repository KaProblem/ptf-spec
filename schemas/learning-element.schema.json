{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KaProblem/ptf-spec/schemas/learning-element.schema.json",
  "title": "PTF Learning Element frontmatter",
  "type": "object",
  "required": [
    "type",
    "ptf_version",
    "id",
    "title",
    "description",
    "lang",
    "levels"
  ],
  "properties": {
    "type": {
      "const": "Learning Element"
    },
    "ptf_version": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^ptf:el/[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "lang": {
      "type": "string",
      "minLength": 1
    },
    "levels": {
      "type": "array",
      "description": "Levels the texts and questions were written and checked for (SPEC.md §5.1). Two adjacent levels are recommended.",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "string",
            "minLength": 1,
            "description": "Legacy form without an ID; ptf-check warns."
          },
          {
            "type": "object",
            "required": [
              "id",
              "text"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "text": {
                "type": "string",
                "minLength": 1
              },
              "criteria": {
                "type": "object",
                "description": "Per level: what counts as having shown this objective at that depth (SPEC.md §6.1). Keys are level IDs of the element.",
                "propertyNames": {
                  "pattern": "^[a-z][a-z0-9-]*$"
                },
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "additionalProperties": true
          }
        ]
      },
      "description": "What the learner can do after this step, as checkable statements with a stable ID that questions and completions refer to (SPEC.md §6.1)."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "about": {
      "description": "Concepts this element teaches, as Wikidata items; the first is the primary concept (SPEC.md §6.6).",
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "wikidata"
        ],
        "properties": {
          "wikidata": {
            "type": "string",
            "pattern": "^Q[1-9][0-9]*$"
          },
          "label": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "uniqueItems": true
    },
    "requires": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "string",
            "pattern": "^ptf:el/[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*$"
          },
          {
            "type": "object",
            "required": [
              "id",
              "catalog"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^ptf:el/[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*$"
              },
              "catalog": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://"
              }
            },
            "additionalProperties": false
          }
        ],
        "description": "An element ID, or { id, catalog } for an element in another library (SPEC.md §6.1)."
      }
    },
    "leads_to": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^ptf:el/[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*$"
      }
    },
    "duration_min": {
      "type": "object",
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    },
    "simulators": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ref"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^ptf:sim/(@[a-z0-9][a-z0-9-]*/)?[a-z0-9][a-z0-9-]*@[\\^~]?(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z.-]+)?$"
          },
          "station": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "levels": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            }
          },
          "role": {
            "enum": [
              "explore",
              "practice",
              "check"
            ]
          },
          "use_when": {
            "type": "string",
            "minLength": 1,
            "description": "When the tutor should reach for this simulator (SPEC.md §6.1)."
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "code": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "ref"
        ],
        "properties": {
          "ref": {
            "type": "string",
            "pattern": "^ptf:code/(@[a-z0-9][a-z0-9-]*/)?[a-z0-9][a-z0-9-]*@[\\^~]?(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z.-]+)?$"
          },
          "step": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "levels": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            }
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "figures": {
      "type": "array",
      "description": "Figures of this element: figures/<id>.svg in the bundle (SPEC.md §6.8).",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "objectives": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "levels": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            }
          },
          "use_when": {
            "type": "string",
            "minLength": 1,
            "description": "When the tutor should show this figure."
          }
        }
      }
    },
    "media": {
      "type": "array",
      "description": "Audio and video of this element (SPEC.md §6.9). The course author makes the files once; hosts only play them.",
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "src",
          "sha256",
          "bytes",
          "duration_s",
          "transcript",
          "license"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "kind": {
            "enum": [
              "audio",
              "video"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "src": {
            "type": "string",
            "pattern": "^(media/[a-z0-9][a-z0-9._-]*\\.(mp3|m4a|mp4)|https://\\S+)$",
            "description": "media/<file> in the bundle (at most 10 MiB), or an https URL for larger files."
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "Hex SHA-256 of the file."
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          },
          "duration_s": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "transcript": {
            "type": "string",
            "pattern": "^media/[a-z0-9][a-z0-9._-]*\\.(txt|vtt)$",
            "description": "Transcript (.txt) or captions (.vtt, required for video) in the bundle."
          },
          "language": {
            "type": "string",
            "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]+)*$"
          },
          "speakers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "generator": {
            "type": "object",
            "description": "Provenance: how the file was made (tool, model, voice) or recorded_by."
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "objectives": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "levels": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            }
          },
          "use_when": {
            "type": "string",
            "minLength": 1,
            "description": "When the tutor should play it."
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "resource"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "resource": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          }
        }
      }
    },
    "generated": {
      "type": "object",
      "required": [
        "by"
      ],
      "properties": {
        "by": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "verified": {
      "type": "object",
      "required": [
        "by"
      ],
      "properties": {
        "by": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "status": {
      "enum": [
        "draft",
        "reviewed",
        "proven",
        "deprecated"
      ]
    },
    "superseded_by": {
      "type": "string",
      "pattern": "^ptf:el/[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z.-]+)?$"
    },
    "license": {
      "type": "string"
    },
    "stats": {
      "type": "object"
    }
  },
  "additionalProperties": true
}
