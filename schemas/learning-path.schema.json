{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KaProblem/ptf-spec/schemas/learning-path.schema.json",
  "title": "PTF Learning Path frontmatter",
  "type": "object",
  "required": [
    "type",
    "ptf_version",
    "id",
    "title",
    "description",
    "lang",
    "steps"
  ],
  "properties": {
    "type": {
      "const": "Learning Path"
    },
    "ptf_version": {
      "type": "string"
    },
    "id": {
      "type": "string",
      "pattern": "^ptf:path/[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "lang": {
      "type": "string",
      "minLength": 1
    },
    "goal": {
      "type": "string"
    },
    "audience": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "element"
        ],
        "properties": {
          "element": {
            "type": "string",
            "pattern": "^ptf:el/[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*$"
          },
          "optional": {
            "type": "boolean"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "enum": [
        "draft",
        "reviewed",
        "proven",
        "deprecated"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[0-9A-Za-z.-]+)?$"
    },
    "license": {
      "type": "string"
    },
    "generated": {
      "type": "object",
      "required": [
        "by"
      ],
      "properties": {
        "by": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "verified": {
      "type": "object",
      "required": [
        "by"
      ],
      "properties": {
        "by": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  },
  "additionalProperties": true
}
