{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/KaProblem/ptf-spec/schemas/question-block.schema.json",
  "title": "PTF Question Block",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "kind",
        "id",
        "level",
        "explanation",
        "question",
        "options"
      ],
      "properties": {
        "kind": {
          "const": "multiple_choice"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "level": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "purpose": {
          "enum": [
            "warmup",
            "check",
            "transfer"
          ]
        },
        "misconception": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "minItems": 3,
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": [
              "text",
              "correct",
              "feedback"
            ],
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "correct": {
                "type": "boolean"
              },
              "feedback": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "contains": {
            "type": "object",
            "properties": {
              "correct": {
                "const": true
              }
            },
            "required": [
              "correct"
            ]
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "kind",
        "id",
        "level",
        "explanation",
        "intro",
        "prefix",
        "answer",
        "hint"
      ],
      "properties": {
        "kind": {
          "const": "guess_next"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "level": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "purpose": {
          "enum": [
            "warmup",
            "check",
            "transfer"
          ]
        },
        "misconception": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        },
        "intro": {
          "type": "string",
          "minLength": 1
        },
        "prefix": {
          "type": "string",
          "minLength": 1
        },
        "answer": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "accepted": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "hint": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    {
      "type": "object",
      "required": [
        "kind",
        "id",
        "level",
        "explanation",
        "text",
        "gaps"
      ],
      "properties": {
        "kind": {
          "const": "cloze"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "level": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "purpose": {
          "enum": [
            "warmup",
            "check",
            "transfer"
          ]
        },
        "misconception": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        },
        "text": {
          "type": "string",
          "pattern": "\\{\\{1\\}\\}"
        },
        "gaps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "items": {
            "type": "object",
            "required": [
              "answer"
            ],
            "properties": {
              "answer": {
                "type": "string",
                "minLength": 1
              },
              "accepted": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "kind",
        "id",
        "level",
        "explanation",
        "question",
        "answer",
        "tolerance"
      ],
      "properties": {
        "kind": {
          "const": "estimate_number"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "level": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "purpose": {
          "enum": [
            "warmup",
            "check",
            "transfer"
          ]
        },
        "misconception": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "answer": {
          "type": "number"
        },
        "tolerance": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "type": "string"
        },
        "scale": {
          "enum": [
            "linear",
            "log"
          ]
        }
      }
    },
    {
      "type": "object",
      "required": [
        "kind",
        "id",
        "level",
        "explanation",
        "instruction",
        "items"
      ],
      "properties": {
        "kind": {
          "const": "ordering"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "level": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "purpose": {
          "enum": [
            "warmup",
            "check",
            "transfer"
          ]
        },
        "misconception": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        },
        "instruction": {
          "type": "string",
          "minLength": 1
        },
        "items": {
          "type": "array",
          "minItems": 3,
          "maxItems": 7,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "kind",
        "id",
        "level",
        "explanation",
        "title",
        "intro",
        "columns",
        "rows",
        "result"
      ],
      "properties": {
        "kind": {
          "const": "calculation_steps"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "level": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "purpose": {
          "enum": [
            "warmup",
            "check",
            "transfer"
          ]
        },
        "misconception": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "intro": {
          "type": "string",
          "minLength": 1
        },
        "columns": {
          "type": "array",
          "minItems": 2,
          "maxItems": 5,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "rows": {
          "type": "array",
          "minItems": 2,
          "maxItems": 10,
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "result": {
          "type": "object",
          "required": [
            "label",
            "value"
          ],
          "properties": {
            "label": {
              "type": "string",
              "minLength": 1
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": [
        "kind",
        "id",
        "level",
        "explanation",
        "question"
      ],
      "properties": {
        "kind": {
          "const": "free_text"
        },
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "level": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "purpose": {
          "enum": [
            "warmup",
            "check",
            "transfer"
          ]
        },
        "misconception": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "explanation": {
          "type": "string",
          "minLength": 1
        },
        "question": {
          "type": "string",
          "minLength": 1
        },
        "rubric": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sample_answer": {
          "type": "string"
        }
      }
    }
  ]
}
